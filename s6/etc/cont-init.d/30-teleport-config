#!/usr/bin/with-contenv bash
# Generate teleport config if it doesn't exist

if [[ ! -x /usr/local/bin/teleport ]]; then
  echo "ERROR: teleport binary not found at /usr/local/bin/teleport"
  exit 1
fi

CONFIG_FILE="${TP_CONFIG:-/config/teleport.yaml}"
DATA_DIR="/config/teleport"

# Create data directory
if [[ ! -d "${DATA_DIR}" ]]; then
  mkdir -p "${DATA_DIR}"
fi

# Generate default config if missing
if [[ ! -e "${CONFIG_FILE}" ]]; then
  echo "Generating default teleport config at ${CONFIG_FILE}"
  /usr/local/bin/teleport configure 2>/dev/null | \
    sed -e "s@/var/lib/teleport@${DATA_DIR}@g" \
        -e 's@.*\.pem$@#&@g' \
    > "${CONFIG_FILE}" || {
      echo "Warning: teleport configure failed, creating minimal config"
      cat > "${CONFIG_FILE}" <<EOF
teleport:
  data_dir: ${DATA_DIR}
  log:
    output: stderr
    severity: INFO
EOF
    }
fi

# Set permissions
chown root:root "${CONFIG_FILE}" "${DATA_DIR}"
