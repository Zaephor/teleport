#!/usr/bin/with-contenv bash
# Run teleport under s6 supervision

if [[ ! -x /usr/local/bin/teleport ]]; then
  echo "ERROR: teleport binary not found"
  exit 111  # s6 exit code for "permanent failure, don't restart"
fi

umask "${UMASK_SET:-022}"

OPTS=("start")

# Parse comma-separated TP_OPTS
if [[ -n "${TP_OPTS:-}" ]]; then
  IFS=',' read -ra EXTRA_OPTS <<< "${TP_OPTS}"
  for opt in "${EXTRA_OPTS[@]}"; do
    OPTS+=("${opt}")
  done
fi

# Convenience flags
if [[ "${TP_INSECURE:-}" == "true" ]]; then
  OPTS+=("--insecure")
fi
if [[ "${TP_INSECURE_NO_TLS:-}" == "true" ]]; then
  OPTS+=("--insecure-no-tls")
fi

# Config file
OPTS+=("--config=${TP_CONFIG:-/config/teleport.yaml}")

exec s6-setuidgid root /usr/local/bin/teleport "${OPTS[@]}"
